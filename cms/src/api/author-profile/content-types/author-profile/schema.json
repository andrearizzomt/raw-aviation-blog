{
  "kind": "collectionType",
  "collectionName": "author_profiles",
  "info": {
    "singularName": "author-profile",
    "pluralName": "author-profiles",
    "displayName": "Author Profile",
    "description": "Public author profile linked to a CMS admin user"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "adminUserId": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "displayName": {
      "type": "string",
      "required": true
    },
    "bio": {
      "type": "richtext",
      "required": true
    },
    "profilePhoto": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "position": {
      "type": "string",
      "required": true
    },
    "teamMemberType": {
      "type": "enumeration",
      "enum": ["co_founder", "contributor"],
      "required": true,
      "default": "contributor"
    },
    "authorSlug": {
      "type": "uid",
      "targetField": "displayName",
      "required": true
    },
    "showContributionCount": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "instagram": {
      "type": "string"
    },
    "facebook": {
      "type": "string"
    },
    "orderWeight": {
      "type": "integer",
      "required": true,
      "default": 1000,
      "min": 0,
      "max": 9999
    }
  }
}
