# ── Core ──────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337

# ── Strapi Secrets ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# Never reuse staging secrets in production
APP_KEYS="key1,key2,key3,key4"
API_TOKEN_SALT=your-api-token-salt
ADMIN_JWT_SECRET=your-admin-jwt-secret
TRANSFER_TOKEN_SALT=your-transfer-token-salt
JWT_SECRET=your-jwt-secret
ENCRYPTION_KEY=your-encryption-key

# ── Email / Resend ─────────────────────────────────────────────────────────────
# Resend — used for admin invites and password resets (https://resend.com)
# Railway blocks outbound SMTP; use the same Resend API key as the Next.js service
# Also add these two vars to Railway → Strapi service → Variables
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=RAW Aviation <noreply@yourdomain.com>

# ── Seed Script ───────────────────────────────────────────────────────────────
# Used by: npm run seed (requires a running Strapi instance)
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=your-admin-password
SEED_USER_PASSWORD=your-user-password
